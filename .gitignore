.env
/bin/
coverage.out
coverage.html

# Task runner cache
.task/

# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work

# OS
.DS_Store

# IntelliJ project files
*.iml
*.iws
*.ipr
.idea

# KiroCrew agent workspace — deny by default, but keep the shareable knowledge.
# Uses `.kiro/*` (not `.kiro/`) so git descends into the dir and the negations apply.
.kiro/*
!.kiro/steering/
!.kiro/specs/
!.kiro/hooks/
